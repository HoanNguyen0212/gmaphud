<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hoan.gmaphud.autosessionlogger</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/sh</string>
        <string>/var/jb/usr/local/bin/gmaphud-auto-session-logger.sh</string>
    </array>
    <key>UserName</key>
    <string>mobile</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/mobile/Documents/GMapHUD/auto-sessions/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Documents/GMapHUD/auto-sessions/launchd.stderr.log</string>
</dict>
</plist>
