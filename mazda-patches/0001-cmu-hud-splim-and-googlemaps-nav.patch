+// [EXTERNAL-NAV] Read turn-by-turn guidance written to /data_persist/nav by
+// cmu_splim_listener from Google Maps / external UDP sources on port 8888.
+// Format: "<icon> <dist_meters> <unixtime> [road_name]"
+static bool read_external_nav(NaviSnapshot &outSnap)
+{
+    FILE *f = std::fopen("/data_persist/nav", "r");
+    if (!f) return false;
+    unsigned int icon = 0;
+    unsigned int dist = 0;
+    long ts = 0;
+    char road[sizeof(outSnap.road_name)] = {0};
+    int n = std::fscanf(f, "%u %u %ld %127[^\n]", &icon, &dist, &ts, road);
+    std::fclose(f);
+    if (n < 3) return false;
+    long now = static_cast<long>(std::time(nullptr));
+    if (now - ts > 8 || icon == 0) return false;  // Stale (>8s) or navigation ended
+
+    std::memset(&outSnap, 0, sizeof(outSnap));
+    outSnap.turn_number  = icon;                  // Carries direct Mazda HUD icon ID (1..60)
+    outSnap.distance_dec = static_cast<int32_t>(dist * 10); // meters * 10
+    outSnap.distance_unit = 1;                    // Meters unit
+    if (n >= 4 && road[0] != \x27\0\x27) {
+        std::strncpy(outSnap.road_name, road, sizeof(outSnap.road_name) - 1);
+        outSnap.road_name[sizeof(outSnap.road_name) - 1] = \x27\0\x27;
+    }
+    return true;
+}
